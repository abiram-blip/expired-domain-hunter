<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.domainhuntercookie</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/test/expired-domain-hunter/refresh_cookie.sh</string>
    </array>
    <!-- 06:40 local (IST) — 50 min before the CI hunt (07:30 IST). Keeps the state-repo
         cookie fresh so CI harvest never hits a stale-cookie login wall. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/test/expired-domain-hunter/cookie_launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/test/expired-domain-hunter/cookie_launchd.err</string>
</dict>
</plist>
